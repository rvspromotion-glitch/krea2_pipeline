# The image carries the handler and the graphs, nothing else. Models live on
# the network volume; tests and git history have no business in a build that
# gets pulled on every cold start.
# setup_volume.sh is NOT ignored — the Dockerfile copies it so the same image
# can seed an empty volume with RUN_SETUP=1.
.git
.github
tests/
README.md
__pycache__/
*.pyc
.pytest_cache/
.venv/
